msgstr "يمكنك مراسلة المدرب أو المتدرب الذي تعمل معه فقط."

#: chat/exceptions.py
msgid "You cannot send messages in this conversation."
msgstr "لا يمكنك إرسال رسائل في هذه المحادثة."

#: chat/exceptions.py
