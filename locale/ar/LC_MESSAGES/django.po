msgid "%(field)s is longer than %(limit)s characters."
msgstr "%(field)s أطول من %(limit)s حرفاً."

#: users/views.py
msgid "The picture could not be saved. Please try again."
msgstr "تعذّر حفظ الصورة. يرجى المحاولة مرة أخرى."

#: users/views.py
msgid "The picture could not be removed. Please try again."
msgstr "تعذّرت إزالة الصورة. يرجى المحاولة مرة أخرى."

#: routine/views.py
#, python-format
msgid "Well done! You finished a workout on %(routine)s."
msgstr "أحسنت! أنهيت تمريناً من %(routine)s."

#: routine/views.py
#, python-format
msgid "%(name)s finished a workout on %(routine)s."
msgstr "أنهى %(name)s تمريناً من %(routine)s."

#: routine/services.py
#, python-format
msgid "A new routine, %(routine)s, has been assigned to you."
msgstr "تم تعيين برنامج جديد لك: %(routine)s."

#: users/exceptions.py
msgid ""
"Your coaching is on hold until support resolves its payment. You can still see "
"your routine."
msgstr "تدريبك معلّق حتى يعالج الدعم دفعته. لا يزال بإمكانك الاطلاع على برنامجك."

#: routine/views.py
msgid "Too much at once: split the clients over more than one request."
msgstr "هذا كثير دفعة واحدة: وزّع المتدربين على أكثر من طلب."

#: users/utils.py
msgid "Invalid or expired code. Please request a new one."
msgstr "الرمز غير صحيح أو منتهي الصلاحية. يرجى طلب رمز جديد."

#: users/utils.py
msgid "This code has expired. Please request a new one."
msgstr "انتهت صلاحية هذا الرمز. يرجى طلب رمز جديد."

#: users/utils.py
msgid "Too many failed attempts. Please try again in 15 minutes."
msgstr "محاولات فاشلة كثيرة جداً. يرجى المحاولة بعد 15 دقيقة."

#: subscription/permissions.py
msgid "An active subscription is needed for this feature."
msgstr "هذه الميزة تحتاج إلى اشتراك فعّال."

#: subscription/permissions.py
msgid "Your plan does not include this feature."
msgstr "خطتك لا تتضمن هذه الميزة."

#: diet/views.py
msgid "Choose your activity level first: your daily calories depend on it."
msgstr "اختر مستوى نشاطك أولاً: سعراتك اليومية تعتمد عليه."

#: diet/trainer_services.py
msgid ""
"This client has not chosen an activity level yet. Ask them to, or set the daily "
"calories yourself."
msgstr "لم يختر هذا المتدرب مستوى نشاطه بعد. اطلب منه ذلك، أو حدّد السعرات اليومية بنفسك."

#: users/views.py
msgid "Upload the profile picture with /api/auth/user/profile-picture/."
msgstr "ارفع صورة الملف الشخصي عبر /api/auth/user/profile-picture/."

#: routine/serializers.py routine/views.py
msgid ""
"How many reps? Send `as_prescribed: true` to use your coach's number."
msgstr "كم تكرارًا؟ أرسل `as_prescribed: true` لاستخدام رقم مدربك."

#: routine/serializers.py routine/views.py
msgid "Your coach did not set reps for this exercise; enter what you did."
msgstr "لم يحدد مدربك عدد التكرارات لهذا التمرين؛ أدخل ما قمت به."

#: routine/views.py
#, python-format
msgid "period must be one of: %(options)s"
msgstr "يجب أن تكون الفترة إحدى القيم: %(options)s"

#: notifications/domain/progress_events.py
msgid "New personal best"
msgstr "رقم شخصي جديد"

#: notifications/domain/progress_events.py
#, python-format
msgid "%(exercise)s: %(weight)s kg x %(reps)s — your best yet."
msgstr "%(exercise)s: %(weight)s كغ × %(reps)s — أفضل أداء لك حتى الآن."

#: notifications/domain/progress_events.py
msgid "Your week"
msgstr "أسبوعك"

#: notifications/domain/progress_events.py
#, python-format
msgid ""
"%(logged)s of %(planned)s sets done, %(perfect)s day(s) with nothing missed."
msgstr "أنجزت %(logged)s من %(planned)s مجموعة، و%(perfect)s يوم دون أي نقص."

#: notifications/domain/progress_events.py
msgid "Your clients this week"
msgstr "متدربوك هذا الأسبوع"

#: notifications/domain/progress_events.py
#, python-format
msgid "%(trained)s of %(clients)s clients trained. %(attention)s need a look."
msgstr "تدرّب %(trained)s من %(clients)s متدربين. %(attention)s بحاجة إلى متابعة."

#: routine/views.py
msgid "Exercise not found."
msgstr "التمرين غير موجود."

#: notifications/domain/subscription_events.py
msgid "Your checkout expired"
msgstr "انتهت صلاحية عملية الدفع"

#: notifications/domain/subscription_events.py
msgid ""
"You did not finish your last checkout, so it was closed. You can start again "
"whenever you like."
msgstr ""
"لم تُكمل عملية الدفع الأخيرة، لذلك أُغلقت. يمكنك البدء من جديد متى شئت."

#: subscription/serializers.py
msgid ""
"Renewal is not automatic: nothing is charged without you. Cancelling is on "
"the subscription itself."
msgstr ""
"التجديد ليس تلقائياً: لا يُخصم أي مبلغ من دونك. الإلغاء من الاشتراك نفسه."
