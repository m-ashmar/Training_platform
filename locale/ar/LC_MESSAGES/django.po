#: diet/validators.py:29
msgid "Daily calories must be a number."
msgstr "يجب أن تكون السعرات اليومية رقمًا."

#: diet/validators.py:34
#, python-format
msgid "Daily calories too low. Minimum is %(min)s kcal."
msgstr "السعرات اليومية منخفضة جدًا. الحد الأدنى %(min)s سعرة حرارية."

#: diet/validators.py:40
#, python-format
msgid "Daily calories too high. Maximum is %(max)s kcal."
msgstr "السعرات اليومية مرتفعة جدًا. الحد الأقصى %(max)s سعرة حرارية."

#: diet/validators.py:53
msgid "Meal count must be an integer."
msgstr "يجب أن يكون عدد الوجبات عددًا صحيحًا."

#: diet/validators.py:58
msgid "Meal count must be at least 1."
msgstr "يجب أن يكون عدد الوجبات 1 على الأقل."

#: diet/validators.py:63
msgid "Meal count cannot exceed 6."
msgstr "لا يمكن أن يتجاوز عدد الوجبات 6."

#: diet/validators.py:75
msgid "Duration days must be an integer."
msgstr "يجب أن تكون المدة بالأيام عددًا صحيحًا."

#: diet/validators.py:80
msgid "Duration must be at least 1 day."
msgstr "يجب أن تكون المدة يومًا واحدًا على الأقل."

#: diet/validators.py:85
msgid "Duration cannot exceed 30 days."
msgstr "لا يمكن أن تتجاوز المدة 30 يومًا."

#: diet/validators.py:97
msgid "Quantity must be a number."
msgstr "يجب أن تكون الكمية رقمًا."

#: diet/validators.py:102
#, python-format
msgid "Quantity too low. Minimum is %(min)sg."
msgstr "الكمية قليلة جدًا. الحد الأدنى %(min)s غرام."

#: diet/validators.py:108
#, python-format
msgid "Quantity too high. Maximum is %(max)sg."
msgstr "الكمية كبيرة جدًا. الحد الأقصى %(max)s غرام."

#: diet/validators.py:123
msgid "Macro targets must be numbers."
msgstr "يجب أن تكون أهداف العناصر الكبرى أرقامًا."

#: diet/validators.py:129
msgid "Macro targets cannot be negative."
msgstr "لا يمكن أن تكون أهداف العناصر الكبرى سالبة."

#: diet/validators.py:135
msgid "Protein target too low. Minimum is 30g per day."
msgstr "هدف البروتين منخفض جدًا. الحد الأدنى 30 غرامًا يوميًا."

