#, python-format
msgid ""
"The first month's fee for coaching between you and %(name)s is held. It is "
"paid to the trainer when the first program is sent."
msgstr ""
"رسوم الشهر الأول من التدريب بينك وبين %(name)s محجوزة، وتُدفع للمدرب عند "
"إرسال أول برنامج."

#: notifications/domain/money_events.py
msgid "Coaching fee paid out"
msgstr "صُرفت رسوم التدريب"

#: notifications/domain/money_events.py
#, python-format
msgid ""
"The fee for month %(month)s of coaching between you and %(name)s was paid to "
"the trainer."
msgstr "صُرفت للمدرب رسوم الشهر %(month)s من التدريب بينك وبين %(name)s."

#: notifications/domain/money_events.py
msgid "Coaching fee returned"
msgstr "أُعيدت رسوم التدريب"

#: notifications/domain/money_events.py
#, python-format
msgid ""
"The held fee for coaching between you and %(name)s was returned to the "
"client's wallet."
msgstr "أُعيدت الرسوم المحجوزة للتدريب بينك وبين %(name)s إلى محفظة المتدرب."

#: notifications/channels/email.py
#, python-format
msgid ""
"We received your payment for %(item)s. Your receipt is attached to this "
"email."
msgstr "استلمنا دفعتك مقابل %(item)s. إيصال الدفع مرفق بهذه الرسالة."

#. The 7-day email before a plan ends.
#: notifications/channels/email.py
#, python-format
msgid "Your subscription ends in %(days)s day."
msgid_plural "Your subscription ends in %(days)s days."
msgstr[0] "ينتهي اشتراكك خلال %(days)s يوم."
msgstr[1] "ينتهي اشتراكك خلال يوم واحد."
msgstr[2] "ينتهي اشتراكك خلال يومين."
msgstr[3] "ينتهي اشتراكك خلال %(days)s أيام."
msgstr[4] "ينتهي اشتراكك خلال %(days)s يوماً."
msgstr[5] "ينتهي اشتراكك خلال %(days)s يوم."

#: notifications/channels/email.py
msgid ""
"When it ends, your diet plan and routine stay saved and you can still see "
"them. Using them needs an active subscription."
msgstr ""
"عند انتهائه تبقى خطتك الغذائية وبرنامجك التدريبي محفوظين ويمكنك الاطلاع "
"عليهما. استخدامهما يحتاج إلى اشتراك فعّال."

#. A label beside the date a plan ends.
#: notifications/channels/email.py
msgid "Ends on"
msgstr "ينتهي في"

#. A label beside the date a plan ended.
#: notifications/channels/email.py
msgid "Ended on"
msgstr "انتهى في"

#: notifications/channels/email.py
msgid "Withdrawal number"
msgstr "رقم طلب السحب"

#. A label beside a sum of money.
#: notifications/channels/email.py
msgid "Amount"
msgstr "المبلغ"

#: notifications/channels/email.py
msgid ""
"You can choose which emails you receive in the app's notification settings."
msgstr ""
"يمكنك اختيار الرسائل التي تصلك بالبريد الإلكتروني من إعدادات الإشعارات في "
"التطبيق."

#. The first line of a notification email, with the person's first name.
#: notifications/channels/email.py
#, python-format
msgid "Hello %(name)s,"
msgstr "مرحبًا %(name)s،"

#. The first line of a notification email, for someone with no first name saved.
#: notifications/channels/email.py
msgid "Hello,"
msgstr "مرحبًا،"

#: chat/services.py
msgid ""
"This route sends text and program cards. Send photos, voice notes and videos "
"to /api/v1/chat/media/."
msgstr ""
"هذا المسار يرسل النصوص وبطاقات البرامج. أرسل الصور والرسائل الصوتية ومقاطع "
"الفيديو إلى /api/v1/chat/media/."

#: chat/services.py
msgid "Only the trainer sends program cards."
msgstr "المدرب وحده يرسل بطاقات البرامج."

#: chat/services.py
msgid "Name exactly one of routine_id or template_id."
msgstr "حدّد واحدًا فقط من routine_id أو template_id."

#: chat/services.py
#, python-format
msgid "This routine has %(days)s days."
msgstr "عدد أيام هذا البرنامج %(days)s."

#: chat/services.py
msgid "There is no such program of yours."
msgstr "لا يوجد لديك برنامج كهذا."

#: chat/services.py
msgid "This client is not on that routine."
msgstr "هذا العميل ليس على هذا البرنامج."

#: chat/services.py
msgid "This client has no routine written from that template yet."
msgstr "لا يوجد لهذا العميل بعد برنامج مكتوب من هذا القالب."

#. The lock-screen preview of a coach's program card sent without a caption.
#: chat/events.py
msgid "Your program was updated"
msgstr "حدّث برنامجك"

#. The lock-screen preview of a coach's program card sent without a caption, with the
#. routine's name («حدّث برنامجك · برنامج القوة», screens/05-chat-utility/Chat.png).
#: chat/events.py
#, python-format
msgid "Your program was updated · %(routine)s"
msgstr "حدّث برنامجك · %(routine)s"

#. A wallet purchase of a program the buyer has a checkout open for (the web hub):
#. paying both would pay twice (`checkout_open`).
#: routine/product_views.py
msgid ""
"A payment for this program is already open. Complete it, or wait for it to "
"close."
msgstr "يوجد دفع مفتوح لهذا البرنامج. أكمله، أو انتظر حتى يُغلق."

#. The .well-known association files (Android App Links, iOS Universal Links) are
#. not configured on this server: releases/app_links.py.
#: releases/app_links.py
msgid "Links that open the app are not set up on this server."
msgstr "روابط فتح التطبيق غير مُعدّة على هذا الخادم."

#. A challenge metric (BACKEND_BUGS B-161): the reps of ONE exercise, the
#. CreateChallenge artboard's «تكرارات تمرين».
#: social/models.py
msgid "Reps of one exercise"
msgstr "تكرارات تمرين"

#. A challenge metric (BACKEND_BUGS B-161): the current run of consecutive days
#. trained, the CreateChallenge artboard's «أيام متتالية».
#: social/models.py
msgid "Days in a row"
msgstr "أيام متتالية"

#. A challenge's `exercise` names no exercise its creator may use (B-161).
#: social/serializers.py
msgid "No such exercise."
msgstr "هذا التمرين غير موجود."

#. An `exercise_reps` challenge with no exercise (B-161, `exercise_required`).
#: social/serializers.py
msgid "Name the exercise whose reps this challenge counts."
msgstr "اختر التمرين الذي يحسب هذا التحدي تكراراته."

#. A challenge's audience (BACKEND_BUGS B-162), the CreateChallenge artboard's
#. «من يستطيع الانضمام: كل المجتمع».
#: social/models.py
msgid "The whole community"
msgstr "كل المجتمع"

#. A challenge's audience (BACKEND_BUGS B-162): «عملائي فقط».
#: social/models.py
msgid "My clients only"
msgstr "عملائي فقط"

#. `audience_trainers_only` (B-162): someone who is not a trainer chose «عملائي فقط».
#: social/serializers.py
msgid "Only a trainer can open a challenge to their clients only."
msgstr "فقط المدرب يمكنه أن يجعل التحدي لعملائه فقط."

#. `challenge_clients_only` (B-162): joining a coach's clients-only challenge.
#: social/views.py
msgid "This challenge is open to its coach's clients only."
msgstr "هذا التحدي مفتوح لعملاء المدرب فقط."

#. `content_too_long` (SIDE_BUGS S-219): a post or comment over the limit, in
#. characters.
#: social/serializers.py
#, python-format
msgid "Keep it under %(limit)d characters."
msgstr "الحد الأقصى %(limit)d حرفاً."
