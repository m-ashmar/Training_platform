# deploy/.env for the single-server deployment (deploy/docker-compose.yml).
#
# DO NOT fill this in by hand unless you have to: `./setup.sh` asks for the values
# below marked ASK, generates the ones marked GENERATED on the server, and writes
# deploy/.env with mode 600. The real file is never committed (.gitignore) and never
# copied into the image (.dockerignore).
#
# How Docker Compose reads this file:
#   * 'single quotes' keep a value exactly as written. Use them for anything that may
#     contain $ or #.
#   * "double quotes" may span several lines (the two PEM keys below).
#   * No spaces around =.
#
# KEEP A COPY of the finished file in the password manager. Three values in it cannot
# be replaced: without FIELD_ENCRYPTION_KEY the health data in the database (and in
# every backup of it) is unreadable for ever, and the same holds for
# AI_TRAINING_PSEUDONYM_KEY and the anonymous AI copies (DEPLOY_CHECKLIST.md section 4).

# --- Where it runs (ASK) -----------------------------------------------------------
# The API's host name, with a DNS A record pointing at this server (in Cloudflare:
# "DNS only", the grey cloud).
API_DOMAIN=api.example.com
# Where Let's Encrypt writes if a certificate is about to expire.
ACME_EMAIL=you@example.com

DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Where the privacy policy, terms and account-deletion page are reached (an https URL).
# Production refuses to boot without it. The API host serves /legal/... itself, so it is
# the base until a hub domain exists.
PUBLIC_PAGES_BASE_URL=https://api.example.com
SENTRY_ENVIRONMENT=staging

# --- Links that open the app (the two files under /.well-known/) ---------------------
# The app's identifiers, fixed by its build. Each file answers 404
# `app_links_not_configured` until its last value below is added: never a guessed id.
APP_LINKS_ANDROID_PACKAGES=com.yallagym.app
APP_LINKS_IOS_BUNDLE_IDS=com.yallagym.app
APP_LINKS_PATHS='/app/*'
# Added when known (optional: a line is filled in or left commented out, never empty).
# Android: the release-signing key's SHA-256 (`keytool -list -v -keystore <file>`), colons
# allowed; several keys comma-separated. iOS: the Apple developer team id, 10 characters.
#APP_LINKS_ANDROID_SHA256_FINGERPRINTS=
#APP_LINKS_IOS_TEAM_ID=

# --- Database and Redis, in this compose file (GENERATED) --------------------------
DB_NAME=yallagym
DB_USER=yallagym
DB_PASSWORD=''
REDIS_PASSWORD=''

# --- Keys (GENERATED; DEPLOY_CHECKLIST.md section 4 says what each protects) ---------
DJANGO_SECRET_KEY=''
FIELD_ENCRYPTION_KEY=''
AI_TRAINING_PSEUDONYM_KEY=''
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# --- Photos and videos: an S3-compatible bucket (ASK) --------------------------------
# For Hetzner Object Storage the address is https://<location>.your-objectstorage.com
# and the region is that location: fsn1, nbg1 or hel1. The bucket must be PRIVATE.
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_REGION_NAME=fsn1
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''

# --- Email, for sign-up codes (ASK) --------------------------------------------------
# Port 587 with STARTTLS is the default and is the one to use: Hetzner blocks outgoing
# ports 25 and 465 on new accounts.
EMAIL_HOST=smtp.resend.com
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL='Yalla Gym <no-reply@example.com>'

# --- Optional: a line is either filled in or left commented out ----------------------
# NEVER leave an optional variable empty (`AI_BASE_URL=`): to the settings that is the
# empty string, not "unset", and it replaces the default.
#
# The AI coach (ASK). Without a key the app runs and the coach answers "unavailable".
# The address ends in /v1; the two prices feed the daily cost ceiling, both or neither.
#AI_API_KEY=''
#AI_BASE_URL=
#AI_ASSISTANT_MODEL=
#AI_PRICE_INPUT_PER_1M_USD=
#AI_PRICE_OUTPUT_PER_1M_USD=
# Messages per person per day to the AI coach. Unset: 10. A whole number, 1 or more.
#AI_MAX_MESSAGES_PER_DAY=10
# Error alerts. Unset: errors go to `docker compose logs` only, and boot warns.
#SENTRY_DSN=''
# Push notifications: the Firebase service account key, base64 of the JSON file
# (`base64 -w0 service-account.json`). Unset: push is off, and boot warns.
#FIREBASE_CREDENTIALS_JSON=''
# The Help page (`GET /api/v1/config/support/`): the support address (default
# support@yalagym.com) and the WhatsApp number, e.g. +9639... (empty hides the button).
#SUPPORT_EMAIL=
#SUPPORT_WHATSAPP=
# Challenges one member hosts at once (default 3, the owner's number; 0 = no limit).
#CHALLENGE_HOST_LIMIT=
# The operator's "large top-up" alert, one cash top-up at or above (defaults 1000000 SYP
# and 100 USD, the ruled numbers).
#WALLET_LARGE_TOPUP_THRESHOLD_SYP=1000000
#WALLET_LARGE_TOPUP_THRESHOLD_USD=100
# ShamCash is NOT set here until ShamCash's official access arrives. SHAMCASH_API_URL has
# no default and names no third party: unset, the server calls no payment API, whatever
# token is set, and the app offers the manual-transfer step a person confirms.
