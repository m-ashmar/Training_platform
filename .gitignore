# Coverage and reports
.coverage
htmlcov/
TEST-*.xml
coverage.xml

# Migrations cache (keep migrations but ignore pycache)
**/migrations/__pycache__/

# Exclude Django app test modules named tests.py
**/tests.py

# Firebase Credentials
yalla-gym-f6a67-firebase-adminsdk-fbsvc-fb99d3a33f.json
firebase-credentials.json

# Redis
*.rdb
dump.rdb

# Build artifacts — regenerated, never source.
# collectstatic writes staticfiles/ during `docker build` (see Dockerfile). 405 of
# them were committed, including hashed duplicates of every file, which is churn on
# every deploy and a merge conflict waiting to happen.
staticfiles/

# .pyc files slipped past __pycache__/ when they sat outside such a directory.
*.pyc
*.pyo

# Generated codebase dumps produced during the audit (113k lines between them).
# They are snapshots of source that is already in this repo, so committing them
# doubles the repo and guarantees they go stale.
*_bundle.txt
_excluded/**/*_bundle.txt

# API keys handed over during development
key.md

# Rotated log files were tracked (logs/diet.log.1, logs/django.log.1 — 90k lines):
# `*.log` did not match them, so they were committed and would ship in any archive.
logs/

# The abandoned Flutter attempt (CLAUDE.md: never read or touch). It entered the index
# once through a `git add -A`; this keeps it out.
/mobile/
/flutter/

# The single-server deployment: its secrets, and the temporary file setup.sh writes
# them through.
deploy/.env
deploy/.env.*
