# =====================================================================
# .env.example — Copy to .env and fill in values for local development
# =====================================================================
# NEVER commit the actual .env file. Only .env.example goes in git.
#
# Usage:
#   cp .env.example .env
#   # Fill in your actual secrets
#   python manage.py runserver
# =====================================================================

# ========================
# Django Core (REQUIRED)
# ========================
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-get-random-secret-key
DJANGO_OLD_SECRET_KEY_1=
JWT_SIGNING_KEY=your-jwt-signing-key-here-must-differ-from-secret-key

# ========================
# Database
# ========================
DB_NAME=training_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# ========================
# AI Integration (optional: with no key the app runs and the AI coach answers
# every turn with the `config_error` code)
# ========================
# The AI coach talks to any service that speaks the OpenAI Chat Completions
# protocol. Leave AI_BASE_URL empty for OpenAI itself; set it (ending in /v1) for
# another provider or a self-hosted server. AI_API_KEY falls back to OPENAI_API_KEY.
AI_API_KEY=your-provider-key
AI_BASE_URL=
AI_ASSISTANT_MODEL=gpt-4o-mini
# Optional JSON merged into every request, for provider-specific switches, e.g.
# AI_EXTRA_BODY={"thinking": {"type": "disabled"}}
AI_EXTRA_BODY=
# Optional, both or neither: the model's price per 1M tokens, for the daily cost ceiling.
AI_PRICE_INPUT_PER_1M_USD=
AI_PRICE_OUTPUT_PER_1M_USD=
# Compare models on the coach's own questions:  python manage.py ai_coach_eval --list
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
HUGGINGFACE_API_TOKEN=hf_your-huggingface-token

# ========================
# Edamam Nutrition API (REQUIRED)
# ========================
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# ========================
# Firebase Push Notifications (REQUIRED)
# ========================
FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ========================
# Email (Optional for local — console backend used if missing)
# ========================
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@trainingplatform.com

# ========================
# Redis (Optional for local — LocMemCache used by default)
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ========================
# Celery
# ========================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================
# Wallet (Local dev only)
# ========================
WALLET_DEV_MODE=False
PLATFORM_ESCROW_EMAIL=platform_escrow@local
PLATFORM_ESCROW_USERNAME=platform_escrow

# ========================
# CORS & CSRF (comma-separated for production)
# ========================
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost

# ========================
# Production Only (do NOT set in local dev)
# ========================
# DJANGO_SETTINGS_MODULE=training_platform.settings_production
# DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
# REDIS_URL=redis://your-redis-host:6379
# SECURE_SSL_REDIRECT=True
# NUM_PROXIES=1
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2

# =============================================================================
# REQUIRED AT BOOT — enforce_production_safety() refuses to start without these
# =============================================================================
# Two of these were required and absent from this file entirely, so a developer
# following it got a crash with no hint which variable was missing.

DJANGO_ALLOWED_HOSTS=api.example.com,www.example.com
REDIS_URL=redis://your-managed-redis:6379

# Background jobs. The default is a localhost URL and there is no Redis inside the
# app container, so leaving these unset means every queued job is lost silently.
# DB6/DB7 deliberately sit outside the six segmented cache DBs (0-5).
CELERY_BROKER_URL=redis://your-managed-redis:6379/6
CELERY_RESULT_BACKEND=redis://your-managed-redis:6379/7

# Set via `fly secrets set` rather than fly.toml [env]:
#   DB_HOST  DB_NAME  DB_USER  DB_PASSWORD
#   EMAIL_HOST_USER  EMAIL_HOST_PASSWORD
#   DJANGO_SECRET_KEY  JWT_PRIVATE_KEY  JWT_PUBLIC_KEY  FIELD_ENCRYPTION_KEY
#   AI_TRAINING_PSEUDONYM_KEY   (>= 32 chars; never rotate while AI training copies exist)
#   CORS_ALLOWED_ORIGINS  CSRF_TRUSTED_ORIGINS

# Media storage. Local development and the test suite leave this alone: files go to
# MEDIA_ROOT on disk. Production MUST set gcs — enforce_production_safety() refuses to
# boot on 'local', because a Fly volume attaches to one machine while several serve
# traffic, so an upload through one is a 404 through the next.
# MEDIA_BACKEND=local
#   MEDIA_BACKEND=gcs  needs, via `fly secrets set`:
#   GS_BUCKET_NAME  GS_PROJECT_ID  GS_CREDENTIALS_JSON (the service-account key file's
#   JSON — a V4 signed URL is signed with its private key, so an access token is not
#   enough). See DEPLOY_CHECKLIST.md step 1b.
# MEDIA_SIGNED_URL_TTL=3600
# The app's own pictures (intro story, banners, empty states) served as plain public
# URLs instead of signed ones, so a CDN can cache them. Only turn this on if the bucket
# actually grants public read on them; a person's media is never public either way.
# MEDIA_PUBLIC_APP_CONTENT=False
# MEDIA_VIDEO_MAX_BYTES=67108864
# MEDIA_VIDEO_MAX_SECONDS=90
