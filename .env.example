# =====================================================================
# .env.example — Copy to .env and fill in values for local development
# =====================================================================
# NEVER commit the actual .env file. Only .env.example goes in git.
#
# Usage:
#   cp .env.example .env
#   # Fill in your actual secrets
#   python manage.py runserver
# =====================================================================

# ========================
# Django Core (REQUIRED)
# ========================
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-get-random-secret-key
DJANGO_OLD_SECRET_KEY_1=
JWT_SIGNING_KEY=your-jwt-signing-key-here-must-differ-from-secret-key

# ========================
# Database
# ========================
DB_NAME=training_platform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# ========================
# AI Integration (REQUIRED)
# ========================
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
HUGGINGFACE_API_TOKEN=hf_your-huggingface-token

# ========================
# Edamam Nutrition API (REQUIRED)
# ========================
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# ========================
# Firebase Push Notifications (REQUIRED)
# ========================
FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ========================
# Email (Optional for local — console backend used if missing)
# ========================
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@trainingplatform.com

# ========================
# Redis (Optional for local — LocMemCache used by default)
# ========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ========================
# Celery
# ========================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================
# Wallet (Local dev only)
# ========================
WALLET_DEV_MODE=False
PLATFORM_ESCROW_EMAIL=platform_escrow@local
PLATFORM_ESCROW_USERNAME=platform_escrow

# ========================
# CORS & CSRF (comma-separated for production)
# ========================
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost

# ========================
# Production Only (do NOT set in local dev)
# ========================
# DJANGO_SETTINGS_MODULE=training_platform.settings_production
# DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
# REDIS_URL=redis://your-redis-host:6379
# SECURE_SSL_REDIRECT=True
# NUM_PROXIES=1
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2
